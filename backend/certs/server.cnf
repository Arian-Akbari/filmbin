[req]
distinguished_name = dn
req_extensions = v3_req
prompt = no
[dn]
C = IR
O = Sharif University of Technology
OU = FilmBin
CN = filmbin.local
[v3_req]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt
[alt]
DNS.1 = filmbin.local
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = 10.0.2.2
IP.3 = 10.44.1.154
