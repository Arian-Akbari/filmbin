# Copy to .env and adjust. Everything has a working default for development.

# --- app
APP_NAME=FilmBin API
DEBUG=false
API_PREFIX=/api/v1

# --- database (SQLite by default; PostgreSQL needs asyncpg installed)
# DATABASE_URL=postgresql+asyncpg://filmbin:secret@localhost:5432/filmbin
DB_ECHO=false

# --- auth  (CHANGE THE SECRET BEFORE DEPLOYING)
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
SHORT_SESSION_DAYS=1
# Development only: returns the password-reset token in the HTTP response
# instead of emailing it.
EXPOSE_RESET_TOKEN=true

# --- IMDb mirror
IMDB_TIMEOUT_SECONDS=15
CACHE_TTL_DETAILS_HOURS=72
CACHE_TTL_SEARCH_HOURS=12
CACHE_TTL_CHART_HOURS=6
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60

# --- limits
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10

# --- media
# Absolute base URL used when building avatar links; leave empty to derive it
# from the incoming request.
PUBLIC_BASE_URL=
